generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// Admin Panel Auth Models
// ============================================

model AdminRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  permissions String  @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users AdminUser[]
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      String   @default("admin")
  roleId    String?
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adminRole AdminRole?      @relation(fields: [roleId], references: [id])
  sessions  AdminSession[]
  auditLogs AdminAuditLog[]
}

model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  device    String?
  browser   String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String?
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================
// ERP System Registry (Multi-ERP Management)
// ============================================

model ErpSystem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  industry    String
  description String?
  dbHost      String
  dbPort      Int      @default(5432)
  dbName      String
  dbUser      String
  dbPassword  String
  sslMode     String   @default("require")
  status      String   @default("active")
  color       String   @default("#6366f1")
  sortOrder   Int      @default(0)
  lastSyncAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syncLogs       SyncLog[]
  webhooks       WebhookConfig[]
  integrations   IntegrationConnector[]
  clients        Client[]
}

// ============================================
// Sync & Integration Models
// ============================================

model SyncLog {
  id            String   @id @default(cuid())
  erpSystemId   String?
  erpSlug       String
  erpName       String
  direction     String   @default("bidirectional") // inbound, outbound, bidirectional
  status        String   @default("pending") // pending, running, success, failed, partial
  syncType      String   @default("auto") // auto, manual, scheduled
  recordsSynced Int      @default(0)
  recordsFailed Int      @default(0)
  durationMs    Int      @default(0)
  errorMessage  String?
  metadata      String?  // JSON string for extra details
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  erpSystem ErpSystem? @relation(fields: [erpSystemId], references: [id], onDelete: SetNull)
}

model WebhookConfig {
  id          String   @id @default(cuid())
  erpSystemId String?
  name        String
  url         String
  secret      String?
  events      String   @default("[]") // JSON array of event types
  isActive    Boolean  @default(true)
  lastTriggerAt  DateTime?
  successCount  Int      @default(0)
  failureCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  erpSystem ErpSystem? @relation(fields: [erpSystemId], references: [id], onDelete: SetNull)
}

// ============================================
// Integration Connectors
// ============================================

model IntegrationConnector {
  id            String   @id @default(cuid())
  erpSystemId   String?
  erpSlug       String
  erpName       String
  type          String   @default("database")
  direction     String   @default("bidirectional")
  status        String   @default("disconnected")
  config        String?
  autoSync      Boolean  @default(false)
  syncInterval  Int      @default(300)
  lastSyncAt    DateTime?
  lastError     String?
  latencyMs     Int?
  clientCount   Int      @default(0)
  tenantCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  erpSystem ErpSystem? @relation(fields: [erpSystemId], references: [id], onDelete: SetNull)
}

// ============================================
// Client Management
// ============================================

model Client {
  id            String   @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  country       String?
  postalCode    String?
  website       String?
  taxId         String?
  status        String   @default("trial")
  industry      String?
  businessType  String?
  companySize   String?
  notes         String?
  databaseName  String?
  erpSlug       String?
  erpSystemId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  erpSystem ErpSystem? @relation(fields: [erpSystemId], references: [id], onDelete: SetNull)
}